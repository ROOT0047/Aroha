{
  "name": "ascend-inspire-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=@aroha/frontend",
    "dev:backend": "npm run dev --workspace=@aroha/backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=@aroha/frontend",
    "build:backend": "npm run build --workspace=@aroha/backend",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3"
  }
}
